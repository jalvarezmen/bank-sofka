{
  "info": {
    "name": "banking-api",
    "description": "Colección API Sistema Bancario — Sofka",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Obtener cliente por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes/1"
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"M\",\n  \"edad\": 35,\n  \"identificacion\": \"9998887776\",\n  \"direccion\": \"Otavalo\",\n  \"telefono\": \"0987654321\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jose Lema Actualizado\",\n  \"genero\": \"M\",\n  \"edad\": 36,\n  \"identificacion\": \"1234567890\",\n  \"direccion\": \"Caldas\",\n  \"telefono\": \"3003458743\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/clientes/1"
          }
        },
        {
          "name": "Eliminar cliente (lógico)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/clientes/1"
          }
        }
      ]
    },
    {
      "name": "Cuentas",
      "item": [
        {
          "name": "Listar cuentas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cuentas"
          }
        },
        {
          "name": "Obtener cuenta por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cuentas/1"
          }
        },
        {
          "name": "Crear cuenta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"999001\",\n  \"tipoCuenta\": \"Ahorro\",\n  \"saldoInicial\": 1500.00,\n  \"clienteId\": 1\n}"
            },
            "url": "{{baseUrl}}/cuentas"
          }
        },
        {
          "name": "Actualizar cuenta",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoCuenta\": \"Ahorro\",\n  \"saldoInicial\": 2000.00,\n  \"saldoDisponible\": 1425.00,\n  \"clienteId\": 1\n}"
            },
            "url": "{{baseUrl}}/cuentas/1"
          }
        },
        {
          "name": "Eliminar cuenta (lógico)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/cuentas/1"
          }
        }
      ]
    },
    {
      "name": "Movimientos",
      "item": [
        {
          "name": "Listar movimientos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movimientos"
          }
        },
        {
          "name": "Obtener movimiento por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movimientos/1"
          }
        },
        {
          "name": "Registrar retiro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaId\": 1,\n  \"valor\": -575\n}"
            },
            "url": "{{baseUrl}}/movimientos"
          }
        },
        {
          "name": "Registrar depósito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaId\": 2,\n  \"valor\": 600\n}"
            },
            "url": "{{baseUrl}}/movimientos"
          }
        },
        {
          "name": "Retiro con saldo insuficiente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaId\": 1,\n  \"valor\": -99999\n}"
            },
            "url": "{{baseUrl}}/movimientos"
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Estado de cuenta por cliente y fechas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reportes?fechaInicio=2024-01-01&fechaFin=2024-12-31&clienteId=1",
              "host": ["{{baseUrl}}"],
              "path": ["reportes"],
              "query": [
                { "key": "fechaInicio", "value": "2024-01-01" },
                { "key": "fechaFin", "value": "2024-12-31" },
                { "key": "clienteId", "value": "1" }
              ]
            }
          }
        }
      ]
    }
  ]
}
